<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>ApiSiteAnalyzer</AssemblyName>
    <RootNamespace>ApiSiteAnalyzer</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 发布先落 CatTemp 暂存区（仓库外），再 move 入空闲槽——
         运行中的 exe 锁文件，直接发布到槽位会失败（KKManager 判例） -->
    <PublishDir>..\..\CatTemp\asa-publish\</PublishDir>
    <Version>0.16.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\wwwroot\index.html" />
  </ItemGroup>

</Project>
